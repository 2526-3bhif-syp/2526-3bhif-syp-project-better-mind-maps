<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="htl.leonding.at.OverviewController"
            stylesheets="@styles.css"
            style="-fx-background-color: #0d1117;">
    <top>
        <VBox>
            <!-- Hero Banner -->
            <HBox styleClass="overview-hero" alignment="CENTER_LEFT">
                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="🧠  Better Mind Maps" styleClass="hero-title"/>
                    <Label fx:id="heroStatsLabel" text="" styleClass="hero-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="8" alignment="CENTER_RIGHT">
                    <Label fx:id="userLabel" styleClass="hero-user"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Logout" onAction="#onLogout" styleClass="btn-ghost"
                                style="-fx-font-size: 11px; -fx-padding: 5 12;"/>
                        <Button text="+ New Mind Map" onAction="#onNewMap" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
            </HBox>
            <!-- Search Bar -->
            <HBox styleClass="overview-search-bar" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Search mind maps..."
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="overview-scroll">
            <VBox spacing="16">
                <padding><Insets top="28" right="32" bottom="48" left="32"/></padding>
                <Label fx:id="sectionLabel" text="MY MIND MAPS" styleClass="overview-section-label"/>
                <FlowPane fx:id="cardsFlow" hgap="20" vgap="20"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
