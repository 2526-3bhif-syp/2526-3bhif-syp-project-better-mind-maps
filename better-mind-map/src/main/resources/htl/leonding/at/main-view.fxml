<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="htl.leonding.at.MainController"
            stylesheets="@styles.css">
    <top>
        <HBox fx:id="toolbar" styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="backBtn" text="← Overview" onAction="#onBackToOverview" styleClass="btn-ghost"/>
            <Separator orientation="VERTICAL" style="-fx-background-color: #1e2433; -fx-pref-width: 1; -fx-pref-height: 24;"/>
            <Button fx:id="newMapBtn" text="+ New Map" onAction="#onCreateNewMap" styleClass="btn-primary"/>
            <Button fx:id="deleteMapBtn" text="🗑  Delete Map" onAction="#onDeleteCurrentMap" styleClass="btn-danger"/>
            <Button fx:id="aiBtn" text="✨ AI Generate" onAction="#onOpenAiChat" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="exportBtn" text="⬇  Export" onAction="#onExportMindMap" styleClass="btn-secondary"/>
            <Button fx:id="presentBtn" text="▶  Present" onAction="#onTogglePresentationMode" styleClass="btn-blue"/>
        </HBox>
    </top>
    <center>
        <HBox>
            <!-- Sidebar: structure tree -->
            <VBox fx:id="sidebar" prefWidth="210" minWidth="210" maxWidth="210"
                  style="-fx-background-color: #0d1117; -fx-border-color: #1e2433; -fx-border-width: 0 1 0 0;">
                <HBox fx:id="sidebarHeader" styleClass="sidebar-header" alignment="CENTER_LEFT">
                    <Label fx:id="structureLabel" text="STRUCTURE" styleClass="sidebar-label"/>
                </HBox>
                <TreeView fx:id="hierarchyTree" styleClass="tree-view" VBox.vgrow="ALWAYS"/>
            </VBox>
            <!-- Editor: TabPane fills remaining space -->
            <TabPane fx:id="tabPane" tabClosingPolicy="ALL_TABS"
                     HBox.hgrow="ALWAYS"
                     style="-fx-background-color: #0d1117;"/>
        </HBox>
    </center>
    <bottom>
        <HBox fx:id="statusbar" styleClass="statusbar" alignment="CENTER_LEFT">
            <Label text="Enter" styleClass="statusbar-key"/>
            <Label fx:id="sbAddChild" text="Add child" styleClass="statusbar-desc"/>
            <Label text="F2" styleClass="statusbar-key"/>
            <Label fx:id="sbEdit" text="Edit" styleClass="statusbar-desc"/>
            <Label text="Del" styleClass="statusbar-key"/>
            <Label fx:id="sbDelete" text="Delete" styleClass="statusbar-desc"/>
            <Label text="↑ ↓ ← →" styleClass="statusbar-key"/>
            <Label fx:id="sbNavigate" text="Navigate" styleClass="statusbar-desc"/>
            <Label text="Tab" styleClass="statusbar-key"/>
            <Label fx:id="sbCycle" text="Cycle" styleClass="statusbar-desc"/>
            <Label text="Scroll" styleClass="statusbar-key"/>
            <Label fx:id="sbZoom" text="Zoom" styleClass="statusbar-desc"/>
            <Label text="Ctrl+Z" styleClass="statusbar-key"/>
            <Label fx:id="sbUndo" text="Undo" styleClass="statusbar-desc"/>
            <Label text="Ctrl+Y" styleClass="statusbar-key"/>
            <Label fx:id="sbRedo" text="Redo" styleClass="statusbar-desc"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="syncStatusLabel" text="● Pending sync"
                   style="-fx-font-size: 11px; -fx-text-fill: #f59e0b; -fx-font-weight: bold;"/>
            <Button fx:id="syncBtn" text="Sync" onAction="#onSync" styleClass="btn-ghost"
                    style="-fx-font-size: 10px; -fx-padding: 4 10;"/>
        </HBox>
    </bottom>
</BorderPane>
