<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="htl.leonding.at.AiChatController"
            stylesheets="@styles.css"
            style="-fx-background-color: #0b0f1a;">

    <!-- Header -->
    <top>
        <HBox style="-fx-background-color: #111827; -fx-padding: 14 28; -fx-border-color: #1e293b; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="16">
            <Button fx:id="backBtn" text="← Zurück" onAction="#onBack"
                    style="-fx-background-color: #1e2433; -fx-text-fill: #8b94a8; -fx-font-size: 13px;
                           -fx-cursor: hand; -fx-padding: 7 14; -fx-background-radius: 8; -fx-border-width: 0;"/>
            <Label text="✨" style="-fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label text="AI Mindmap Assistant"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                <Label fx:id="mapContextLabel" text="Kein Mindmap geladen"
                       style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="● Bereit"
                   style="-fx-text-fill: #10b981; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- Chat + Welcome overlay -->
    <center>
        <StackPane style="-fx-background-color: #0b0f1a;">

            <!-- Chat messages -->
            <ScrollPane fx:id="chatScrollPane" fitToWidth="true"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-width: 0;">
                <VBox fx:id="chatContainer" spacing="18">
                    <padding><Insets top="28" right="100" bottom="28" left="100"/></padding>
                </VBox>
            </ScrollPane>

            <!-- Welcome screen (hidden after first message) -->
            <VBox fx:id="welcomeOverlay" alignment="CENTER" spacing="30"
                  style="-fx-background-color: #0b0f1a; -fx-padding: 60;">
                <Label text="✨" style="-fx-font-size: 56px;"/>
                <VBox alignment="CENTER" spacing="10">
                    <Label text="AI Mindmap Assistant"
                           style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                    <Label text="Stelle mir eine Frage oder wähle einen Vorschlag aus"
                           style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                </VBox>
                <FlowPane fx:id="suggestionChips" hgap="12" vgap="12" alignment="CENTER" prefWidth="720"/>
            </VBox>

        </StackPane>
    </center>

    <!-- Input area -->
    <bottom>
        <VBox style="-fx-background-color: #111827; -fx-border-color: #1e293b; -fx-border-width: 1 0 0 0; -fx-padding: 14 100;">
            <HBox fx:id="suggestionRow" spacing="8" style="-fx-padding: 0 0 10 0;"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="promptField" promptText="Schreibe eine Nachricht..." HBox.hgrow="ALWAYS"
                           onAction="#onSend"
                           style="-fx-background-color: #1e2433; -fx-text-fill: #f1f5f9;
                                  -fx-prompt-text-fill: #475569; -fx-font-size: 14px;
                                  -fx-padding: 14 18; -fx-background-radius: 14; -fx-border-width: 0;"/>
                <Button text="➤" onAction="#onSend"
                        style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-size: 17px;
                               -fx-padding: 13 20; -fx-background-radius: 14; -fx-cursor: hand; -fx-border-width: 0;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
